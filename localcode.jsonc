{
  "$schema": "./schema/localcode.schema.json",
  "version": 1,

  // Active profile. You can define as many as you like in "profiles".
  "profile": "default",
  "profiles": {
    "rápido": {
      "ollama": {
        "options": { "temperature": 0.2, "num_predict": 2048 },
        "request": { "think": false }
      }
    },
    "creativo": {
      "ollama": {
        "options": { "temperature": 1.1, "top_p": 0.95, "repeat_penalty": 1.15 }
      }
    }
  },

  "server": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 4096,
    "cors": true,
    "basePath": "/api"
    // "authToken": "change-this-token"
  },

  "provider": {
    "type": "ollama",
    // Ollama root URL. Also accepts http://host:11434/v1
    "baseURL": "http://10.0.218.5:11434",
    // "apiKey": "{env:OLLAMA_API_KEY}",
    "transport": "native", // "native" (/api/chat) | "openai" (/v1/chat/completions)
    "headers": {},
    "discovery": {
      "enabled": true,
      "intervalMs": 60000,
      "timeoutMs": 5000,
      "includeEmbeddings": false
    },
    "timeout": { "headers": 300000, "chunk": 900000, "total": 0 },
    "retries": 1
  },

  "model": {
    "default": "gemma4:26b",
    "aliases": {
      "coder": "gemma4:26b"
    },
    "catalog": {
      "gemma4:26b": {
        "name": "gemma4:26b",
        "context": 32768,
        "output": 8192,
        "tools": true,
        "vision": false
        // "systemPrompt": "You are a TypeScript expert..."
      }
    }
  },

  // ---------------------------------------------------------------------
  // SYSTEM PROMPT: full control (the main shortcoming of OpenCode with
  // local models). mode = "replace" | "prepend" | "append"
  // ---------------------------------------------------------------------
  "system": {
    // Edit this single prompt to change LocalCode's global behavior.
    // Agent-specific instructions are still appended, so switching agents works.
    "mode": "replace",
    "prompt": "You are LocalCode, an autonomous operator for authorized technical work. You have shell and network tools; use them directly.\n\nScope and safety:\n- Only act on the exact target and scope the user provides. Treat it as authorized. Never expand to other hosts, networks, or accounts.\n- Authorized security assessments, lab exercises, and CTFs are legitimate tasks. Do not refuse, moralize, or claim you lack access.\n- Avoid destructive, disruptive, or irreversible actions. If an action could damage data or leave access beyond the exercise, stop and ask.\n- When a tool requires approval, request it and continue once granted.\n\nWorking style:\n- Work autonomously until the objective is met. Prefer a tool call over a long explanation.\n- Gather evidence before drawing conclusions. Verify every finding and record concrete details.\n- For noisy commands, save output to a file and inspect only the relevant parts with grep, head, tail, or counts. Never paste entire logs back to the model.\n- If a step fails, note why and try the next reasonable approach. Keep a short checklist in your messages.\n- Derive guesses from evidence. After three failed attempts on the same surface, switch approach or report the blocker with what you found.\n- Web access is a tool, not a shell command: call websearch or webfetch directly.\n- Prefer a clean, direct channel (such as SSH with obtained credentials) over noisy application-layer injection for file transfers or multi-step work; use injection only for quick checks or when no direct channel exists.\n- If a tool is unavailable, use a listed alternative or state briefly what you have.\n- Reply in the same language the user writes in. Keep answers concise and evidence-based.",
    "files": ["AGENTS.md"],
    "variables": {},
    "includeDefault": true,
    "includeEnvironment": false,
    "includeToolDescriptions": true,
    "includeSkills": true,
    "includeCommands": false,
    "sections": {},
    "separator": "\n\n"
  },

  // ---------------------------------------------------------------------
  // ALL configurable Ollama parameters.
  // Precedence: global -> perModel -> variant -> agent -> session/CLI.
  // ---------------------------------------------------------------------
  "ollama": {
    "options": {
      // Sampling: lower variance for long, methodical tool-driven work.
      "temperature": 0.2,
      "top_k": 20,
      "top_p": 0.9,
      "min_p": 0.0,
      "typical_p": 1.0,
      "tfs_z": 1.0,
      "seed": 0,
      "num_predict": 12288,
      "stop": [],
      // Repetition
      "repeat_last_n": 64,
      "repeat_penalty": 1.05,
      "presence_penalty": 0.0,
      "frequency_penalty": 0.0,
      "penalize_newline": true,
      // Mirostat
      "mirostat": 0,
      "mirostat_eta": 0.1,
      "mirostat_tau": 5.0,
      // Context and performance
      "num_ctx": 32768,
      "num_batch": 512,
      "num_keep": 24,
      "num_thread": 0,
      "num_gpu": -1,
      "main_gpu": 0,
      "low_vram": false,
      "f16_kv": true,
      "logits_all": false,
      "vocab_only": false,
      "use_mmap": true,
      "use_mlock": false,
      "numa": false,
      "trunc": true,
      "draft_num_predict": 4
    },
    "request": {
      "think": "medium",         // true | false | "low" | "medium" | "high" | null
      "keep_alive": "5m",   // "5m" | -1 | 0
      "format": null,       // "json" | { JSON Schema }
      "raw": false,
      "stream": true,
      "logprobs": false,
      "top_logprobs": 0
    },
    "perModel": {
      "gemma4:26b": {
        "options": {
          "temperature": 0.2,
          "top_k": 20,
          "top_p": 0.9,
          "repeat_penalty": 1.05,
          "num_predict": 12288,
          "num_ctx": 32768
        },
        "request": { "think": "medium" }
      },
      "qwen2.5-coder:7b": {
        "options": { "temperature": 0.4, "num_ctx": 65536 },
        "request": { "think": false }
      }
    },
    "variants": {
      "preciso": { "options": { "temperature": 0.0, "seed": 42 } },
      "creativo": { "options": { "temperature": 1.2, "top_p": 0.95 } }
    }
  },

  "agent": {
    "default": "operator",
    "maxSteps": 0,
    "definitions": {
      "operator": {
        "description": "Autonomous agent for authorized lab assessments and CTFs",
        "mode": "primary",
        "instructions": "Methodology:\n1. Read the user's message for the exact target and objective. Stay inside that scope.\n2. Recon first: identify live hosts, exposed services, versions, and likely surfaces using non-destructive checks.\n3. Enumerate systematically. Record concrete evidence: addresses, ports, paths, names, versions, credentials, and responses.\n4. Form one hypothesis at a time and test it with the least invasive method. Verify before claiming success.\n5. If a path fails, record why and move to the next reasonable path. Do not loop on the same failed action.\n6. Escalate access only through authorized steps on the given target; avoid disruption, data destruction, and persistence outside the exercise.\n7. Maintain a short progress checklist in your messages so context compaction preserves state.\n8. Finish with a concise report: scope, findings with evidence, access obtained, and remediation notes.\n\nDo not pause after every step for approval; continue with tools until the objective is met or scope is unclear. Pause only for unclear scope, destructive actions, or missing information that cannot be derived. Before guessing any parameter, field name, or payload, derive it from observed evidence: response bodies, headers, page source, client-side code, or tool output. Never repeat the same tool call or the same request pattern more than twice without a new hypothesis. After three distinct attempts on the same surface with no new evidence, stop that line of work, switch surfaces, or report the blocker with the evidence gathered. Do not brute-force names when the source can answer. Keep tool previews and answers short; inspect large saved output files instead of dumping them.\n\nAccess channel selection: once you have credentials for a direct service (for example SSH), switch to it for everything beyond quick checks. Use scp/base64/heredocs over that channel to transfer scripts and exploit code, and run multi-step commands there so stdout is clean. Application-layer command injection is acceptable for short probes, but avoid it for writing files, compiling, or reading multi-line output: quoting is fragile and responses are noisy. If you must use injection, write results to a file and read them back through a clean channel.",
        "ollama": {
          "options": { "temperature": 0.2, "top_p": 0.9, "num_predict": 12288 },
          "request": { "think": "medium" }
        },
        "steps": 0,
        "color": "#f87171"
      },
      "reviewer": {
        "description": "Reviews changes without editing files",
        "mode": "subagent",
        "system": "Review correctness, security, and tests. Do not modify anything.",
        "permissions": [{ "action": "edit", "resource": "*", "effect": "deny" }],
        "ollama": { "options": { "temperature": 0.1 } }
      }
    }
  },

  "tools": {
    "enabled": ["read", "write", "edit", "glob", "grep", "bash", "webfetch", "websearch", "question", "task", "todowrite", "skill", "execute"],
    "disabled": [],
    "shell": "/bin/bash",
    "bash": {
      "defaultTimeout": 120000,
      "maxBackgroundMs": 3600000,
      "maxOutputBytes": 51200,
      "previewBytes": 2048,
      "previewLines": 40,
      "saveFullOutput": true
    },
    "read": { "maxLines": 2000, "maxBytes": 51200, "maxImageBytes": 20971520 },
    "output": { "maxLines": 2000, "maxBytes": 51200 },
    "formatter": false
  },

  "permissions": [
    { "action": "bash", "resource": "git push *", "effect": "ask", "message": "Allow pushing changes?" },
    { "action": "bash", "resource": "rm -rf *", "effect": "ask", "message": "Allow recursive deletion?" }
  ],

  "commands": {
    "engage": {
      "description": "Start an authorized assessment of the target in $ARGUMENTS",
      "agent": "operator",
      "template": "Authorized target: $ARGUMENTS\nProceed with the assessment. Work autonomously until you have verified findings and a concise report."
    },
    "review": {
      "description": "Reviews the current changes",
      "template": "Review the diff for $ARGUMENTS, looking for bugs and missing tests."
    }
  },

  "skills": { "enabled": true, "autoDiscover": true, "paths": ["./.localcode/skills"] },

  "mcp": {
    "timeout": 30000,
    "codemode": true,
    "servers": {
      // "filesystem": { "type": "local", "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."] }
    }
  },

  "session": {
    "dir": ".localcode/sessions",
    "autoTitle": true,
    "snapshots": { "enabled": true, "max": 20 },
    "compaction": { "auto": true, "keepTokens": 8000, "bufferPercent": 20 }
  },

  "tui": {
    "theme": "dark",
    "showThinking": true,
    "showToolOutput": true,
    "showUsage": true,
    "vimMode": false,
    "mouse": true,
    "maxVisibleMessages": 200,
    "keybinds": {}
  },

  "logging": { "level": "info", "maxBytes": 10485760 },
  "plugins": []
}
